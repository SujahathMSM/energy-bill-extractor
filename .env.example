# Copy to .env and fill in. Every setting is optional; the defaults are shown.
# Never commit .env: it holds API keys (it is in .gitignore).

# --- Model --------------------------------------------------------------------------------
# Which model reads the bill: mock | anthropic | openai | ollama
#   mock      no key needed; returns ground truth for the bundled sample bills, a fixed
#             example bill for anything else. For demos and tests.
BILLX_BACKEND=mock

# Claude (BILLX_BACKEND=anthropic)
ANTHROPIC_API_KEY=
# claude-sonnet-5-5 (default, most accurate on poor photos) or claude-haiku-5-5 (~16x cheaper)
BILLX_ANTHROPIC_MODEL=claude-sonnet-5-5
# prompt | json_schema | tool. prompt works with every model; the others fall back to it
# when the model rejects them (see README, "Design decisions").
BILLX_ANTHROPIC_OUTPUT_MODE=prompt

# OpenAI, or any OpenAI-compatible server such as vLLM or LM Studio (BILLX_BACKEND=openai)
OPENAI_API_KEY=
# Set for a self-hosted server, e.g. http://localhost:8001/v1; leave empty for OpenAI.
OPENAI_BASE_URL=
# Required for BILLX_BACKEND=openai, e.g. a vision model your server hosts.
BILLX_OPENAI_MODEL=
# json_schema | json_object | none (json_schema falls back to json_object if rejected)
BILLX_OPENAI_RESPONSE_FORMAT=json_schema

# Ollama on this machine (BILLX_BACKEND=ollama). docker compose overrides the URL.
OLLAMA_BASE_URL=http://localhost:11434/v1
BILLX_OLLAMA_MODEL=qwen2.5vl:3b

# --- Model calls --------------------------------------------------------------------------
# Attempts per bill: the first answer plus repair attempts when the reply is invalid JSON or
# does not match the schema (the errors are sent back to the model). 1-5.
BILLX_MAX_ATTEMPTS=2
# Seconds to wait for one model call.
BILLX_TIMEOUT_S=90
# SDK retries of transient errors (connection, 408, 409, 429, 5xx) with exponential backoff.
BILLX_PROVIDER_RETRIES=2
BILLX_MAX_OUTPUT_TOKENS=4096

# --- Input limits -------------------------------------------------------------------------
BILLX_MAX_UPLOAD_MB=10
# PDF pages sent to the model; later pages are skipped with a warning in the response.
BILLX_MAX_PAGES=3
# Longest side, in pixels, of each page image sent to the model (512-4096).
BILLX_MAX_IMAGE_SIDE=1568
# Images that decode to more pixels than this are rejected (decompression-bomb guard).
BILLX_MAX_IMAGE_MEGAPIXELS=40
# Photos with an edge-sharpness score below this fail the input_quality check and are flagged
# for review. Calibrated on synthetic photos (see DECISIONS.md). 0 disables.
BILLX_BLUR_THRESHOLD=2.0

# --- Server -------------------------------------------------------------------------------
# Where `python -m bill_extractor` listens. docker compose publishes BILLX_PORT on the host.
# If 8000 is taken (Docker Desktop and WSL often hold it), use e.g. 8010.
BILLX_HOST=127.0.0.1
BILLX_PORT=8000
# Comma-separated browser origins allowed to call the API (CORS). Empty = same-origin only,
# which is all the bundled UI needs. Example: https://app.example.com
BILLX_CORS_ORIGINS=
