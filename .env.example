# Which model reads the bill: mock | anthropic | openai | ollama
BILLX_BACKEND=mock

# Claude
ANTHROPIC_API_KEY=
BILLX_ANTHROPIC_MODEL=claude-sonnet-5-5
# prompt | json_schema | tool (prompt works with every model; see README)
BILLX_ANTHROPIC_OUTPUT_MODE=prompt

# OpenAI, or any OpenAI-compatible server such as vLLM (set OPENAI_BASE_URL for those)
OPENAI_API_KEY=
OPENAI_BASE_URL=
BILLX_OPENAI_MODEL=
# json_schema | json_object | none
BILLX_OPENAI_RESPONSE_FORMAT=json_schema

# Ollama on this machine
OLLAMA_BASE_URL=http://localhost:11434/v1
BILLX_OLLAMA_MODEL=qwen2.5vl:3b

# Limits
BILLX_MAX_PAGES=3
BILLX_MAX_UPLOAD_MB=10
BILLX_MAX_ATTEMPTS=2
BILLX_TIMEOUT_S=90
